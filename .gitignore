# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env
.env.local
.env.production
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend
backend/node_modules
backend/dist
backend/uploads/**
!backend/uploads/**/
!backend/uploads/**/.gitkeep

# database backups / data exports — never commit real data or credentials
# baked into a dump (see backend/scripts/export-postgres-data.js)
backend/migration-backup/
migration-backup/
postgres-export.json
*.sql
*.sql.gz
*.dump

# archived PostgreSQL-dialect migrations — superseded by the MySQL migration
# history, kept locally only for reference
backend/prisma/migrations-postgresql-backup/

# logs
logs/
*.log

# one-off local test scripts (this project's convention: __*.mjs in the repo
# root, written during a session and deleted afterwards — ignored as a
# safety net in case one is ever left behind)
/__*.mjs
/__*.ts
/__*.js

# local AI-assistant tooling state — not part of the application
.claude/

