# ─────────────────────────────────────────────────────────────────────────
# DATABASE — MySQL/MariaDB (Prisma). Projecto migrado de PostgreSQL em 2026-10.
# Local (XAMPP):  mysql://root:@127.0.0.1:3306/sala_de_imprensa_endiama
# cPanel:         mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:@127.0.0.1:3306/sala_de_imprensa_endiama"

# ─────────────────────────────────────────────────────────────────────────
# AUTH — gerar valores longos e aleatórios distintos para cada ambiente,
# nunca reutilizar os de desenvolvimento em produção.
# ─────────────────────────────────────────────────────────────────────────
JWT_SECRET="change_me_to_a_long_random_string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me_to_a_different_long_random_string"
JWT_REFRESH_EXPIRES_IN="30d"

# ─────────────────────────────────────────────────────────────────────────
# SERVIDOR
# ─────────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────
# URLs — nunca hardcoded no código; tudo lido destas variáveis.
# Em produção, substituir pelo domínio real (https://...), nunca por um IP.
# ─────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5180
ADDITIONAL_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

API_BASE_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────────────────
# UPLOADS — limite de tamanho por ficheiro (MB). 200 cobre imagens, áudio e
# vídeo; ajustar conforme os limites reais do plano de hosting em cPanel.
# ─────────────────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=200

# ─────────────────────────────────────────────────────────────────────────
# SMTP (opcional — newsletter/notificações por email)
# ─────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ENDIAMA Notícias <no-reply@example.com>"

# ─────────────────────────────────────────────────────────────────────────
# SEED — apenas para `npm run prisma:seed` num ambiente novo/vazio. Sem
# passwords por omissão: o seed falha de propósito se estas não estiverem
# definidas. Nunca colocar passwords reais aqui (ficheiro de exemplo).
# ─────────────────────────────────────────────────────────────────────────
SEED_ADMIN_PASSWORD=
SEED_EDITOR_PASSWORD=
SEED_JOURNALIST_PASSWORD=
