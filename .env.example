# ─────────────────────────────────────────────────────────────────────────
# FRONTEND (Next.js) — variáveis realmente lidas pelo código.
# Em produção, substituir pelo domínio real do backend (https://...),
# nunca por um IP de rede local.
# ─────────────────────────────────────────────────────────────────────────

# Base da API do backend (usada por todos os pedidos fetch, públicos e admin).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Origem do backend, usada para construir URLs de imagens/ficheiros
# carregados (/uploads/...) a partir de caminhos relativos guardados na base
# de dados — ver src/lib/media.ts.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Domínio canónico público do portal (sem barra final). Usado em canonical,
# Open Graph, robots.txt, sitemaps e dados estruturados. Se vazio, usa
# https://www.novo.endiamaimprensa.com (com www — domínio oficial). Lido no
# build: alterar exige novo build.
NEXT_PUBLIC_SITE_URL=https://www.novo.endiamaimprensa.com

# Opcionais — códigos de verificação de propriedade (só o valor do atributo
# "content" da meta tag fornecida por cada ferramenta). Vazio = não emitido.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Opcional — Google Analytics 4 (ex.: G-XXXXXXXXXX). Vazio = DESLIGADO: nenhum
# script é carregado e nenhum aviso é mostrado. Se definido, o GA4 só carrega
# depois de o visitante aceitar no aviso de consentimento. Antes de activar,
# actualizar a Política de Privacidade (hoje declara que não há cookies de
# rastreio).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Opcional — se definido, protege o endpoint interno /api/revalidate (apenas
# invalida cache, nunca lê/escreve dados) com um segredo partilhado. Deixar
# vazio é seguro para uso local; ver nota no relatório sobre este endpoint
# antes de decidir se activar em produção.
REVALIDATE_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# SERVIDOR — lidas pelo server.js gerado pelo próprio Next.js em
# .next/standalone/ (next build com output: "standalone"), não pelo código
# da aplicação directamente. O Node Selector do cPanel define PORT
# automaticamente; não é preciso defini-la manualmente nesse caso.
# ─────────────────────────────────────────────────────────────────────────
PORT=5180
HOSTNAME=0.0.0.0
NODE_ENV=production
